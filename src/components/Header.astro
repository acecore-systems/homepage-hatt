---
import { externalAttrs } from '@/utils/routes'

type Site = {
  name: string
  icon: string
  headerLinks: { label: string; href: string }[]
}

const { site } = Astro.props as { site: Site }

const compactLabelByLabel: Record<string, string> = {
  '3D作品': '3D',
  ショップ: 'Shop',
  ブログ: 'Blog',
  Acecore: 'Ace',
}
---

<header class="site-header">
  <nav class="site-nav" aria-label="メインナビゲーション">
    <a class="brand-link" href="/">
      <span class="brand-mark" aria-hidden="true">
        <span class="icon-[lucide--feather]"></span>
      </span>
      <span class="brand-copy">
        <span class="brand-name">{site.name}</span>
        <span class="brand-subtitle">hatt homepage</span>
      </span>
    </a>
    <div class="nav-links">
      <button
        class="nav-search-button"
        type="button"
        data-search-open
        data-hatt-event="search_open"
        data-hatt-label="header_search"
        data-hatt-location="header"
        aria-controls="site-search-modal"
        aria-label="検索"
      >
        <span class="icon-[lucide--search]" aria-hidden="true"></span>
      </button>
      {
        site.headerLinks.map((link) => {
          const isExternal = link.href.startsWith('http')
          const compactLabel = compactLabelByLabel[link.label] ?? link.label

          return (
            <a
              class:list={['nav-link', { 'nav-link--external': isExternal }]}
              href={link.href}
              {...externalAttrs(link.href)}
              aria-label={link.label}
              data-hatt-event="nav_click"
              data-hatt-label={link.label}
              data-hatt-location="header"
            >
              <span class="nav-label nav-label--full">{link.label}</span>
              <span class="nav-label nav-label--compact" aria-hidden="true">
                {compactLabel}
              </span>
            </a>
          )
        })
      }
      <a
        class="nav-link nav-cart-link nav-icon-link"
        href="/shop/cart/"
        data-hatt-event="nav_click"
        data-hatt-label="カート"
        data-hatt-location="header"
        aria-label="カート"
      >
        <span class="icon-[lucide--shopping-cart]" aria-hidden="true"></span>
        <span class="sr-only">カート</span>
        <strong data-shop-cart-count hidden>0</strong>
      </a>
    </div>
  </nav>
</header>
