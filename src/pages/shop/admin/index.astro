---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { getShopProducts } from '@/lib/shop/content'

const fileProducts = (await getShopProducts({ includeDraft: true })).filter(
  (product) => product.fulfillmentType !== 'physical',
)
---

<BaseLayout
  title="ショップ管理"
  description="ショップ注文の簡易管理画面です。"
  canonicalPath="/shop/admin/"
  robots="noindex,nofollow"
>
  <section class="page-hero">
    <div class="section-inner narrow-page">
      <p class="hero-note">
        <span class="icon-[lucide--lock]" aria-hidden="true"></span>
        Shop admin
      </p>
      <h1>ショップ管理</h1>
      <p class="lead">注文、発送、手動納品、返金メモを確認・更新します。</p>
    </div>
  </section>

  <section class="section-band">
    <div class="section-inner shop-admin-shell">
      <div class="shop-admin-session">
        <p>
          <span class="icon-[lucide--shield-check]" aria-hidden="true"></span>
          <span data-shop-admin-email>認証を確認しています</span>
        </p>
        <a class="secondary-button" href="/cdn-cgi/access/logout">
          ログアウト
        </a>
      </div>

      <nav class="shop-admin-nav" aria-label="ショップ管理メニュー">
        <a href="#product-files">商品ZIP</a>
        <a href="#orders">注文</a>
      </nav>

      <div class="shop-admin-content" data-shop-admin-content hidden>
        <section class="shop-admin-files" id="product-files">
          <div class="section-heading">
            <div>
              <h2>商品ZIP</h2>
            </div>
            <button
              class="secondary-button"
              type="button"
              data-shop-files-refresh
            >
              再読込
            </button>
          </div>

          <form class="shop-admin-upload-form" data-shop-file-upload>
            <label>
              商品
              <select name="productSlug" data-shop-file-product required>
                {
                  fileProducts.map((product) => (
                    <option value={product.slug}>{product.title}</option>
                  ))
                }
              </select>
            </label>
            <label>
              ZIPファイル
              <input
                type="file"
                name="file"
                accept=".zip,application/zip,application/x-zip-compressed"
                data-shop-file-input
                required
              />
            </label>
            <button class="primary-button" type="submit">アップロード</button>
          </form>
          <div
            class="shop-admin-upload-progress"
            data-shop-file-progress
            hidden
          >
            <progress max="100" value="0"></progress>
            <span>0%</span>
          </div>
          <p class="shop-admin-file-note">
            非公開R2に分割保存します。1ファイル最大5 GiBです。
          </p>
          <div class="shop-admin-file-list" data-shop-file-list>
            <p class="empty-state">商品を選択してください。</p>
          </div>
        </section>

        <section class="shop-admin-orders" id="orders" data-shop-admin-orders>
          <div class="section-heading">
            <div>
              <h2>注文一覧</h2>
            </div>
            <button
              class="secondary-button"
              type="button"
              data-shop-admin-refresh
            >
              更新
            </button>
          </div>
          <div data-shop-admin-list>
            <p class="empty-state">注文を読み込んでいます。</p>
          </div>
        </section>
      </div>
      <p class="shop-cart-status" data-shop-admin-status></p>
    </div>
  </section>

  <script is:inline>
    ;(() => {
      const contentShell = document.querySelector('[data-shop-admin-content]')
      const list = document.querySelector('[data-shop-admin-list]')
      const status = document.querySelector('[data-shop-admin-status]')
      const refresh = document.querySelector('[data-shop-admin-refresh]')
      const sessionEmail = document.querySelector('[data-shop-admin-email]')
      const fileForm = document.querySelector('[data-shop-file-upload]')
      const fileProduct = document.querySelector('[data-shop-file-product]')
      const fileInput = document.querySelector('[data-shop-file-input]')
      const fileList = document.querySelector('[data-shop-file-list]')
      const fileRefresh = document.querySelector('[data-shop-files-refresh]')
      const fileProgress = document.querySelector('[data-shop-file-progress]')
      const fileProgressBar = fileProgress?.querySelector('progress')
      const fileProgressText = fileProgress?.querySelector('span')
      const fulfillmentStatusLabels = {
        pending: '受付中',
        digital_ready: 'ダウンロード準備完了',
        manual_pending: '手動納品待ち',
        manual_complete: '手動納品済み',
        shipping_pending: '発送準備中',
        shipped: '発送済み',
        complete: '完了',
        canceled: 'キャンセル済み',
      }
      const fulfillmentTypeLabels = {
        digital: 'デジタル配布',
        manual: '手動納品',
        physical: '物理発送',
      }

      function formatJpy(amount) {
        return new Intl.NumberFormat('ja-JP', {
          style: 'currency',
          currency: 'JPY',
          maximumFractionDigits: 0,
        }).format(amount || 0)
      }

      function setStatus(message) {
        status.textContent = message || ''
      }

      async function initialize() {
        setStatus('認証を確認しています...')
        const response = await fetch('/api/shop/admin/session')
        const payload = await readPayload(response)
        if (!response.ok) {
          setStatus(
            payload.message ||
              'Cloudflare Accessのセッションを確認できませんでした。',
          )
          return
        }

        sessionEmail.textContent = payload.email || 'Cloudflare Access'
        contentShell.hidden = false
        await Promise.all([loadOrders(), loadFiles()])
      }

      async function loadOrders() {
        setStatus('注文を読み込んでいます...')
        const response = await fetch('/api/shop/admin/orders')
        const payload = await readPayload(response)
        if (!response.ok) {
          setStatus(payload.message || '注文を読み込めませんでした。')
          return
        }
        renderOrders(payload.orders || [])
        setStatus('')
      }

      function renderOrders(orders) {
        list.replaceChildren()
        if (orders.length === 0) {
          const empty = document.createElement('p')
          empty.className = 'empty-state'
          empty.textContent = '注文はまだありません。'
          list.append(empty)
          return
        }

        orders.forEach((order) => {
          const article = document.createElement('article')
          article.className = 'shop-admin-order'
          const header = document.createElement('div')
          header.className = 'shop-admin-order-head'
          const title = document.createElement('h3')
          if (order.customerEmail) {
            const emailLink = document.createElement('a')
            emailLink.href = `mailto:${encodeURIComponent(order.customerEmail)}`
            emailLink.textContent = order.customerEmail
            title.append(emailLink)
          } else {
            title.textContent = order.id
          }
          const meta = document.createElement('p')
          const feeText = order.platformFeeJpy
            ? ` / 手数料 ${formatJpy(order.platformFeeJpy)}`
            : ''
          const customerNameText = order.customerName
            ? ` / ${order.customerName}`
            : ''
          meta.textContent = `${formatJpy(order.totalJpy)}${feeText} / ${order.paymentStatus} / ${fulfillmentStatusLabels[order.fulfillmentStatus] || order.fulfillmentStatus}${customerNameText}`
          header.append(title, meta)

          const items = document.createElement('ul')
          ;(order.items || []).forEach((item) => {
            const row = document.createElement('li')
            row.textContent = `${item.title} x ${item.quantity} (${fulfillmentTypeLabels[item.fulfillmentType] || item.fulfillmentType} / ${fulfillmentStatusLabels[item.itemStatus] || item.itemStatus})`
            items.append(row)
          })

          const form = document.createElement('form')
          form.className = 'shop-admin-order-form'
          form.append(
            buildStatusField(order.fulfillmentStatus),
            buildInputField('追跡番号', 'trackingNumber', order.trackingNumber),
            buildTextareaField('手動納品メモ', 'manualNote', order.manualNote),
            buildTextareaField(
              '返金・キャンセルメモ',
              'refundNote',
              order.refundNote,
            ),
          )
          const submit = document.createElement('button')
          submit.className = 'primary-button'
          submit.type = 'submit'
          submit.textContent = '保存'
          form.append(submit)
          form.addEventListener('submit', (event) =>
            updateOrder(event, order.id),
          )
          article.append(header, items, form)
          list.append(article)
        })
      }

      async function loadFiles() {
        const productSlug = fileProduct?.value
        if (!productSlug) return

        fileList.replaceChildren()
        const loading = document.createElement('p')
        loading.className = 'empty-state'
        loading.textContent = 'ZIPを読み込んでいます。'
        fileList.append(loading)

        const response = await fetch(filesUrl('list', { productSlug }))
        const payload = await readPayload(response)
        if (!response.ok) {
          fileList.replaceChildren()
          setStatus(payload.message || 'ZIPを読み込めませんでした。')
          return
        }

        renderFiles(payload.files || [], productSlug)
      }

      function renderFiles(files, productSlug) {
        fileList.replaceChildren()
        if (files.length === 0) {
          const empty = document.createElement('p')
          empty.className = 'empty-state'
          empty.textContent = '登録済みのZIPはありません。'
          fileList.append(empty)
          return
        }

        files.forEach((file) => {
          const row = document.createElement('div')
          row.className = 'shop-admin-file-row'
          const details = document.createElement('div')
          const name = document.createElement('strong')
          name.textContent = file.filename
          const meta = document.createElement('span')
          meta.textContent = `${formatBytes(file.size)} / ${new Intl.DateTimeFormat('ja-JP', { dateStyle: 'medium', timeStyle: 'short' }).format(new Date(file.uploadedAt))}`
          details.append(name, meta)

          const download = document.createElement('a')
          download.className = 'secondary-button'
          download.href = filesUrl('download', {
            productSlug,
            key: file.key,
          })
          download.textContent = 'ダウンロード'
          row.append(details, download)
          fileList.append(row)
        })
      }

      async function uploadFile(event) {
        event.preventDefault()
        const file = fileInput?.files?.[0]
        const productSlug = fileProduct?.value
        if (!file || !productSlug) {
          setStatus('商品とZIPファイルを選択してください。')
          return
        }
        if (!file.name.toLowerCase().endsWith('.zip')) {
          setStatus('ZIPファイルを選択してください。')
          return
        }

        const submit = fileForm.querySelector('button[type="submit"]')
        submit.disabled = true
        fileProduct.disabled = true
        fileInput.disabled = true
        updateUploadProgress(0)
        fileProgress.hidden = false
        setStatus('アップロードを開始しています...')

        let upload = null
        try {
          const createResponse = await fetch(filesUrl('create'), {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              productSlug,
              filename: file.name,
              size: file.size,
            }),
          })
          const createPayload = await readPayload(createResponse)
          if (!createResponse.ok) {
            throw new Error(
              createPayload.message || 'アップロードを開始できませんでした。',
            )
          }
          upload = createPayload

          const parts = []
          const partSize = upload.partSize
          for (
            let offset = 0, partNumber = 1;
            offset < file.size;
            partNumber += 1
          ) {
            const chunk = file.slice(offset, offset + partSize)
            const part = await uploadPart(
              productSlug,
              upload,
              partNumber,
              chunk,
            )
            parts.push(part)
            offset += chunk.size
            updateUploadProgress(Math.round((offset / file.size) * 100))
          }

          const completeResponse = await fetch(filesUrl('complete'), {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              productSlug,
              key: upload.key,
              uploadId: upload.uploadId,
              parts,
            }),
          })
          const completePayload = await readPayload(completeResponse)
          if (!completeResponse.ok) {
            throw new Error(
              completePayload.message || 'アップロードを完了できませんでした。',
            )
          }

          fileInput.value = ''
          setStatus('ZIPをアップロードしました。')
          await loadFiles()
        } catch (error) {
          if (upload?.uploadId) {
            await fetch(
              filesUrl('abort', {
                productSlug,
                key: upload.key,
                uploadId: upload.uploadId,
              }),
              { method: 'DELETE' },
            ).catch(() => {})
          }
          setStatus(
            error instanceof Error
              ? error.message
              : 'アップロードできませんでした。',
          )
        } finally {
          submit.disabled = false
          fileProduct.disabled = false
          fileInput.disabled = false
          fileProgress.hidden = true
        }
      }

      async function uploadPart(productSlug, upload, partNumber, chunk) {
        let lastError = null
        for (let attempt = 0; attempt < 3; attempt += 1) {
          try {
            const response = await fetch(
              filesUrl('part', {
                productSlug,
                key: upload.key,
                uploadId: upload.uploadId,
                partNumber,
              }),
              {
                method: 'PUT',
                headers: { 'Content-Type': 'application/octet-stream' },
                body: chunk,
              },
            )
            const payload = await readPayload(response)
            if (!response.ok || !payload.part) {
              throw new Error(
                payload.message ||
                  `ZIPの${partNumber}番目を保存できませんでした。`,
              )
            }
            return payload.part
          } catch (error) {
            lastError = error
            if (attempt < 2) {
              await new Promise((resolve) =>
                setTimeout(resolve, 500 * 2 ** attempt),
              )
            }
          }
        }
        throw lastError
      }

      function updateUploadProgress(value) {
        if (fileProgressBar) fileProgressBar.value = value
        if (fileProgressText) fileProgressText.textContent = `${value}%`
      }

      function filesUrl(action, parameters = {}) {
        const url = new URL('/api/shop/admin/files', window.location.origin)
        if (action && action !== 'list') url.searchParams.set('action', action)
        Object.entries(parameters).forEach(([key, value]) => {
          url.searchParams.set(key, String(value))
        })
        return `${url.pathname}${url.search}`
      }

      function formatBytes(value) {
        const bytes = Number(value) || 0
        if (bytes < 1024) return `${bytes} B`
        if (bytes < 1024 ** 2) return `${(bytes / 1024).toFixed(1)} KiB`
        if (bytes < 1024 ** 3) {
          return `${(bytes / 1024 ** 2).toFixed(1)} MiB`
        }
        return `${(bytes / 1024 ** 3).toFixed(2)} GiB`
      }

      function buildFieldShell(labelText, control) {
        const label = document.createElement('label')
        label.append(labelText, control)
        return label
      }

      function buildStatusField(currentValue) {
        const select = document.createElement('select')
        select.name = 'fulfillmentStatus'
        ;[
          'pending',
          'digital_ready',
          'manual_pending',
          'manual_complete',
          'shipping_pending',
          'shipped',
          'complete',
          'canceled',
        ].forEach((value) => {
          const option = document.createElement('option')
          option.value = value
          option.textContent = fulfillmentStatusLabels[value] || value
          option.selected = value === currentValue
          select.append(option)
        })
        return buildFieldShell('ステータス', select)
      }

      function buildInputField(labelText, name, value) {
        const input = document.createElement('input')
        input.name = name
        input.value = value || ''
        return buildFieldShell(labelText, input)
      }

      function buildTextareaField(labelText, name, value) {
        const textarea = document.createElement('textarea')
        textarea.name = name
        textarea.value = value || ''
        return buildFieldShell(labelText, textarea)
      }

      async function updateOrder(event, orderId) {
        event.preventDefault()
        const formData = new FormData(event.currentTarget)
        setStatus('保存しています...')
        const response = await fetch(
          `/api/shop/admin/orders/${encodeURIComponent(orderId)}`,
          {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(Object.fromEntries(formData.entries())),
          },
        )
        const payload = await readPayload(response)
        if (!response.ok) {
          setStatus(payload.message || '保存できませんでした。')
          return
        }
        setStatus('保存しました。')
        await loadOrders()
      }

      async function readPayload(response) {
        const contentType = response.headers.get('content-type') || ''
        if (!contentType.includes('application/json')) {
          return {
            message:
              'Cloudflare Accessのセッションが切れています。ページを再読み込みしてください。',
          }
        }
        return response.json()
      }

      refresh?.addEventListener('click', loadOrders)
      fileRefresh?.addEventListener('click', loadFiles)
      fileProduct?.addEventListener('change', loadFiles)
      fileForm?.addEventListener('submit', uploadFile)
      initialize()
    })()
  </script>
</BaseLayout>
