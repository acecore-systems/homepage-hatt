{
  "name": "homepage-hatt",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/write-shop-runtime-catalog.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/write-shop-runtime-catalog.mjs",
    "build": "npm run test:turnstile && astro build && node scripts/audit-image-alts.mjs && pagefind --site dist",
    "audit:image-alts": "node scripts/audit-image-alts.mjs",
    "preview": "astro preview",
    "sync:external": "node scripts/sync-external-feeds.mjs",
    "sync:booth": "node scripts/sync-external-feeds.mjs --booth",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "pretest:cms": "node scripts/write-shop-runtime-catalog.mjs",
    "test:cms": "node --test tests/cms-admin-init.test.mjs tests/cms-product-files.test.mjs tests/cms-proxy.test.mjs tests/cms-content-validation.test.mjs tests/cms-reference-validation.test.mjs tests/cms-github-app-setup.test.mjs tests/safe-json.test.mjs",
    "pretest:shop": "node scripts/write-shop-runtime-catalog.mjs",
    "test:shop": "node --test tests/shop-access.test.mjs tests/shop-contact.test.mjs tests/shop-disclosure.test.mjs tests/shop-checkout-files.test.mjs tests/shop-fulfillment.test.mjs tests/shop-webhook.test.mjs tests/shop-admin-files.test.mjs",
    "test:external-feed": "node --test tests/external-feed-sync.test.mjs",
    "test:sitemap": "node --test tests/sitemap-lastmod.test.mjs",
    "test:turnstile": "node --test tests/turnstile-retry.test.mjs",
    "test:ui-foundation": "node --test tests/ui-foundation.test.mjs",
    "setup:cms-app": "node scripts/setup-cms-github-app.mjs --owner acecore-systems --repo homepage-hatt --app-name \"Acecore Hatt CMS\" --site-url https://hatt.acecore.net --pages-project homepage-hatt",
    "pretypecheck:functions": "node scripts/write-shop-runtime-catalog.mjs",
    "typecheck:functions": "tsc --project tsconfig.functions.json",
    "types:functions": "wrangler types functions/worker-configuration.d.ts --config wrangler.jsonc --include-runtime false",
    "types:functions:check": "wrangler types functions/worker-configuration.d.ts --config wrangler.jsonc --include-runtime false --check",
    "types:course-email": "wrangler types workers/course-email-service/worker-configuration.d.ts --config workers/course-email-service/wrangler.jsonc --include-runtime false",
    "types:course-email:check": "wrangler types workers/course-email-service/worker-configuration.d.ts --config workers/course-email-service/wrangler.jsonc --include-runtime false --check",
    "typecheck:course-email": "tsc --project workers/course-email-service/tsconfig.json",
    "test:course-email": "node --experimental-strip-types --test workers/course-email-service/test/index.test.mjs",
    "types:disclosure-email": "wrangler types workers/disclosure-email-service/worker-configuration.d.ts --config workers/disclosure-email-service/wrangler.jsonc --include-runtime false",
    "types:disclosure-email:check": "wrangler types workers/disclosure-email-service/worker-configuration.d.ts --config workers/disclosure-email-service/wrangler.jsonc --include-runtime false --check",
    "typecheck:disclosure-email": "tsc --project workers/disclosure-email-service/tsconfig.json",
    "test:disclosure-email": "node --experimental-strip-types --test workers/disclosure-email-service/test/index.test.mjs",
    "validate:content": "node scripts/validate-content.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.2.0",
    "fast-xml-parser": "^5.10.1",
    "graphql": "^17.0.2",
    "js-yaml": "^5.2.3",
    "jose": "^6.2.8",
    "rehype-external-links": "^3.0.0",
    "satori": "^0.29.0",
    "sharp": "^0.35.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@astrojs/markdown-remark": "^7.2.1",
    "@cloudflare/workers-types": "^5.20260816.1",
    "@iconify-json/lucide": "^1.2.121",
    "@iconify/tailwind4": "^1.2.3",
    "@tailwindcss/vite": "^4.3.3",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "wrangler": "^4.123.0"
  },
  "overrides": {
    "sharp": "$sharp"
  },
  "engines": {
    "node": ">=24.18.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260811.1": true
  }
}
