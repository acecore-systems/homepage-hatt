        "COURSE_SIGNUP_EMAIL_FROM": "Hattのホームページ <noreply@hatt.acecore.net>",
        "COURSE_SIGNUP_EMAIL_TO": "borubin@outlook.jp",
        "SHOP_CONTACT_EMAIL_FROM": "Hatt shop <noreply@hatt.acecore.net>",
        "SHOP_CONTACT_EMAIL_TO": "borubin@outlook.jp",
        "SHOP_ACCESS_TEAM_DOMAIN": "https://acecore.cloudflareaccess.com",
        "SHOP_ACCESS_AUD": "12faf91ff5d66812272272ec869557e4367f7f0a48cb1447f37e4b9e34de9e84",
        "SHOP_ACCESS_HOSTNAMES": "hatt.acecore.net,www.hatt.acecore.net,homepage-hatt.pages.dev,*.homepage-hatt.pages.dev",
        "SHOP_DISCLOSURE_ENABLED": "true",
        "SHOP_DISCLOSURE_ALLOWED_HOSTNAMES": "hatt.acecore.net,www.hatt.acecore.net",
        "SHOP_DISCLOSURE_TURNSTILE_SITE_KEY": "0x4AAAAAADgFdX0i7Etno1bL",
      },
      "services": [
        {
          "binding": "COURSE_EMAIL_SERVICE",
          "service": "homepage-hatt-course-email",
        },
        {
          "binding": "DISCLOSURE_EMAIL_SERVICE",
          "service": "homepage-hatt-disclosure-email",
        },
        {
          "binding": "CMS_AI",
          "service": "cms-ai",
        },
      ],
    },
  },
}
