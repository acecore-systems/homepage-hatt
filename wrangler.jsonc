{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "homepage-hatt",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-06-07",
  "secrets": {
    "required": [
      "CMS_ACCESS_ALLOWED_EMAILS",
      "CMS_GITHUB_APP_CLIENT_ID",
      "CMS_GITHUB_APP_INSTALLATION_ID",
      "CMS_GITHUB_APP_PRIVATE_KEY",
      "COMMENT_HASH_SALT",
      "TURNSTILE_SECRET_KEY",
      "STRIPE_SECRET_KEY",
      "STRIPE_WEBHOOK_SECRET",
      "SHOP_DOWNLOAD_TOKEN_SECRET",
      "SHOP_DISCLOSURE_HMAC_SECRET",
      "SHOP_DISCLOSURE_SERVICE_TOKEN",
    ],
  },
  "d1_databases": [
    {
      "binding": "COMMENTS_DB",
      "database_name": "homepage-hatt-comments",
      "database_id": "97d09eef-97fe-4d11-8c28-93bb40bfd234",
      "migrations_dir": "migrations",
    },
    {
      "binding": "SHOP_DB",
      "database_name": "homepage-hatt-shop",
      "database_id": "a79e27cc-a53c-47de-b464-7cab1218438e",
      "migrations_dir": "migrations/shop",
    },
  ],
  "r2_buckets": [
    {
      "binding": "SHOP_FILES",
      "bucket_name": "homepage-hatt-shop-files",
    },
  ],
  "vars": {
    "COMMENT_ALLOWED_HOSTNAMES": "hatt.acecore.net,www.hatt.acecore.net,homepage-hatt.pages.dev",
    "COURSE_SIGNUP_EMAIL_FROM": "Hattのホームページ <noreply@hatt.acecore.net>",
    "COURSE_SIGNUP_EMAIL_TO": "borubin@outlook.jp",
    "SHOP_CONTACT_EMAIL_FROM": "Hatt shop <noreply@hatt.acecore.net>",
    "SHOP_CONTACT_EMAIL_TO": "borubin@outlook.jp",
    "SHOP_ACCESS_TEAM_DOMAIN": "https://acecore.cloudflareaccess.com",
    "SHOP_ACCESS_AUD": "12faf91ff5d66812272272ec869557e4367f7f0a48cb1447f37e4b9e34de9e84",
    "SHOP_ACCESS_HOSTNAMES": "hatt.acecore.net,www.hatt.acecore.net,homepage-hatt.pages.dev,*.homepage-hatt.pages.dev",
    "SHOP_DISCLOSURE_ENABLED": "true",
    "SHOP_DISCLOSURE_ALLOWED_HOSTNAMES": "hatt.acecore.net,www.hatt.acecore.net",
    "SHOP_DISCLOSURE_TURNSTILE_SITE_KEY": "0x4AAAAAADgFdX0i7Etno1bL",
  },
  "services": [
    {
      "binding": "COURSE_EMAIL_SERVICE",
      "service": "homepage-hatt-course-email",
    },
    {
      "binding": "DISCLOSURE_EMAIL_SERVICE",
      "service": "homepage-hatt-disclosure-email",
    },
    {
      "binding": "CMS_AI",
      "service": "cms-ai",
    },
  ],
  "env": {
    "preview": {
      "secrets": {
        "required": [
          "CMS_ACCESS_ALLOWED_EMAILS",
          "CMS_GITHUB_APP_CLIENT_ID",
          "CMS_GITHUB_APP_INSTALLATION_ID",
          "CMS_GITHUB_APP_PRIVATE_KEY",
          "COMMENT_HASH_SALT",
          "TURNSTILE_SECRET_KEY",
          "STRIPE_SECRET_KEY",
          "STRIPE_WEBHOOK_SECRET",
          "SHOP_DOWNLOAD_TOKEN_SECRET",
          "SHOP_DISCLOSURE_HMAC_SECRET",
          "SHOP_DISCLOSURE_SERVICE_TOKEN",
        ],
      },
      "d1_databases": [
        {
          "binding": "COMMENTS_DB",
          "database_name": "homepage-hatt-comments",
          "database_id": "97d09eef-97fe-4d11-8c28-93bb40bfd234",
          "migrations_dir": "migrations",
        },
        {
          "binding": "SHOP_DB",
          "database_name": "homepage-hatt-shop",
          "database_id": "a79e27cc-a53c-47de-b464-7cab1218438e",
          "migrations_dir": "migrations/shop",
        },
      ],
      "r2_buckets": [
        {
          "binding": "SHOP_FILES",
          "bucket_name": "homepage-hatt-shop-files",
        },
      ],
      "vars": {
        "COMMENT_ALLOWED_HOSTNAMES": "hatt.acecore.net,www.hatt.acecore.net,homepage-hatt.pages.dev",
        "COURSE_SIGNUP_EMAIL_FROM": "Hattのホームページ <noreply@hatt.acecore.net>",
        "COURSE_SIGNUP_EMAIL_TO": "borubin@outlook.jp",
        "SHOP_CONTACT_EMAIL_FROM": "Hatt shop <noreply@hatt.acecore.net>",
        "SHOP_CONTACT_EMAIL_TO": "borubin@outlook.jp",
        "SHOP_ACCESS_TEAM_DOMAIN": "https://acecore.cloudflareaccess.com",
        "SHOP_ACCESS_AUD": "12faf91ff5d66812272272ec869557e4367f7f0a48cb1447f37e4b9e34de9e84",
        "SHOP_ACCESS_HOSTNAMES": "hatt.acecore.net,www.hatt.acecore.net,homepage-hatt.pages.dev,*.homepage-hatt.pages.dev",
        "SHOP_DISCLOSURE_ENABLED": "true",
        "SHOP_DISCLOSURE_ALLOWED_HOSTNAMES": "hatt.acecore.net,www.hatt.acecore.net",
        "SHOP_DISCLOSURE_TURNSTILE_SITE_KEY": "0x4AAAAAADgFdX0i7Etno1bL",
      },
      "services": [
        {
          "binding": "COURSE_EMAIL_SERVICE",
          "service": "homepage-hatt-course-email",
        },
        {
          "binding": "DISCLOSURE_EMAIL_SERVICE",
          "service": "homepage-hatt-disclosure-email",
        },
        {
          "binding": "CMS_AI",
          "service": "cms-ai",
        },
      ],
    },
    "production": {
      "secrets": {
        "required": [
          "CMS_ACCESS_ALLOWED_EMAILS",
          "CMS_GITHUB_APP_CLIENT_ID",
          "CMS_GITHUB_APP_INSTALLATION_ID",
          "CMS_GITHUB_APP_PRIVATE_KEY",
          "COMMENT_HASH_SALT",
          "TURNSTILE_SECRET_KEY",
          "STRIPE_SECRET_KEY",
          "STRIPE_WEBHOOK_SECRET",
          "SHOP_DOWNLOAD_TOKEN_SECRET",
          "SHOP_DISCLOSURE_HMAC_SECRET",
          "SHOP_DISCLOSURE_SERVICE_TOKEN",
        ],
      },
      "d1_databases": [
        {
          "binding": "COMMENTS_DB",
          "database_name": "homepage-hatt-comments",
          "database_id": "97d09eef-97fe-4d11-8c28-93bb40bfd234",
          "migrations_dir": "migrations",
        },
        {
          "binding": "SHOP_DB",
          "database_name": "homepage-hatt-shop",
          "database_id": "a79e27cc-a53c-47de-b464-7cab1218438e",
          "migrations_dir": "migrations/shop",
        },
      ],
      "r2_buckets": [
        {
          "binding": "SHOP_FILES",
          "bucket_name": "homepage-hatt-shop-files",
        },
